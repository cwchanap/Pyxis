+	return {
+		resolved,
+		setup,
+		enginePreflight,
+		llmUsability,
+		fallbackNotice,
+		startBlockedReason: startBlockedReasonFor(
+			setup.rivalKind,
+			enginePreflight,
+			llmUsability
