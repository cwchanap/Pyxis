+
+	const selectHumanSide = useCallback(
+		(side: ChessSide) => {
+			setupTouchedRef.current = true;
+			explicitKindRef.current = setup.rivalKind;
+			clearedFallbackNoticeRef.current = null;
+			setFallbackNotice(null);
