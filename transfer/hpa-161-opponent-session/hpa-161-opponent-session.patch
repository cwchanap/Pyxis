+	test('wrong version falls back to defaults', () => {
+		const storage = createMemoryStorage({
+			[RIVAL_PREFERENCES_STORAGE_KEY]: JSON.stringify({
+				version: 2,
+				lastRivalKind: 'llm',
+				humanSideByRival: { engine: 'black', llm: 'black' },
